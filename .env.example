# NCRB BOOZE COMPARE - Environment Configuration Example
# Copy this file to .env and configure as needed.

# Flask Server Config
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=college-academic-demo-secret-key-2026

# AI Chatbot API Configuration (Optional)
# If provided, the assistant can use OpenAI API.
# If left blank, the application uses its built-in offline academic knowledge engine.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
