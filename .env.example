# NCRB BOOZE COMPARE - Environment Configuration
# Copy this file to .env and configure as needed.

# Flask Server Config
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_PORT=5050
SECRET_KEY=ncrb-luxury-cellar-secret-key-2026

# AI Chatbot API Configuration (Google Gemini & OpenAI)
# If provided, the assistant uses Google Gemini API (default: gemini-1.5-flash).
# Can also fall back to OpenAI API or the built-in intelligent luxury sommelier engine.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
